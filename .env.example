# Token de acceso (mínimo 24 caracteres). Genera uno con:  openssl rand -hex 32
MCP_TOKEN=

# UID:GID con permiso de lectura sobre los datos expuestos
PUID=1000
PGID=100

# Raíz de tus servicios Docker (para la carpeta vacía de statvfs de volume1)
DOCKER_ROOT=/volume1/Docker

# Rutas cuyos nombres/metadatos puede listar y buscar el MCP (separadas por comas)
FILE_ROOTS=/archive1,/archive2

# Uso de disco: etiqueta=ruta dentro del contenedor
STORAGE_PATHS=volume1=/mnt/volume1,archive1=/archive1,archive2=/archive2

# Arrays RAID que disparan alerta si están degradados (el resto solo informa)
MD_WATCH=md1

# Etiquetas legibles para los arrays RAID: array=etiqueta,...
MD_LABELS=md1=volume1,md0=volume0,md126=swap

# IP del NAS en la que se publica el puerto 8088 (LAN o Tailscale).
# Por defecto 127.0.0.1 (solo el propio NAS). No uses 0.0.0.0.
MCP_BIND_IP=127.0.0.1

# Notas para el cliente (se envian como instrucciones del servidor): describe tu
# arquitectura para que el asistente no suponga. Una sola linea; usa \n para saltos.
# Evita comillas dobles, $ y #.
NAS_NOTES="volume1 es un RAID1 de dos NVMe. sda y sdb son discos de datos sueltos sin RAID y no son miembros de ningun array. Este MCP es de solo lectura: no sugieras acciones sobre discos ni arrays."
