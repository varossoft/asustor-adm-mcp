# Access token (minimum 24 characters). Generate one with:  openssl rand -hex 32
MCP_TOKEN=

# UID:GID with read permission on the exposed data
PUID=1000
PGID=100

# Root of your Docker services (for volume1's empty statvfs folder)
DOCKER_ROOT=/volume1/Docker

# Paths whose names/metadata the MCP may list and search (comma-separated)
FILE_ROOTS=/archive1,/archive2

# Disk usage: label=path inside the container
STORAGE_PATHS=volume1=/mnt/volume1,archive1=/archive1,archive2=/archive2

# RAID arrays that raise an alert when degraded (the rest are informational only)
MD_WATCH=md1

# Human-readable labels for the RAID arrays: array=label,...
MD_LABELS=md1=volume1,md0=volume0,md126=swap

# NAS IP on which port 8088 is published (LAN or Tailscale).
# Defaults to 127.0.0.1 (the NAS itself only). Do not use 0.0.0.0.
MCP_BIND_IP=127.0.0.1

# Notes for the client (sent as server instructions): describe your
# architecture so the assistant does not assume. Single line; use \n for line breaks.
# Avoid double quotes, $ and #.
NAS_NOTES="volume1 is a RAID1 of two NVMe drives. sda and sdb are loose data disks without RAID and are not members of any array. This MCP is read-only: do not suggest actions on disks or arrays."

# --- Write mode (OPTIONAL, off by default) -------------------------------------
# Adds ONE tool, restart_container, limited to the names below. Needs the second
# proxy:  docker compose --profile write up -d --build
# ALLOW_WRITE=1
# WRITE_ALLOWLIST=sonarr,radarr,lazylibrarian
# DOCKER_WRITE_HOST=http://docker-socket-proxy-write:2375
